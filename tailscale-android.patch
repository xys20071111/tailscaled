+// detectAndroidDefaultTable returns the routing table number of the physical
+// network that currently holds the default route on Android. It returns 0 if
+// detection fails.
+//
+// Android's netd puts each network in its own routing table and selects it
+// with policy rules keyed on fwmark, so exit-node traffic leaving tailscale0
+// has to be looked up in the table of the underlying physical network. Note
+// that this is not necessarily the table of the "current" default route: a
+// connected VPN app (e.g. v2rayNG) owns the default network, and a plain
+// route lookup would return its tunnel's table and route exit-node traffic
+// into the VPN.
+func detectAndroidDefaultTable() int {
+	if routeTable, _ := linuxfw.AndroidDefaultPhysicalNetwork(); routeTable > 0 {
+		return routeTable
+	}
+	// Fall back to a plain lookup of the current default route. With no
+	// other VPN connected this is the physical network's table; when a VPN
+	// app is connected it is the VPN's table, matching the behavior before
+	// physical-network detection existed.
+	routes, err := netlink.RouteGet(net.IPv4(8, 8, 8, 8))
+	if err != nil || len(routes) == 0 {
+		return 0
+	}
+	if routes[0].Table > 0 {
+		return routes[0].Table
+	}
+	return 0
+}
+
+// getAndroidIPRules returns the policy routing rules Tailscale uses on
+// Android. Android's netd owns the low priority rules (VPN rules live at
+// 13000), so Tailscale has to slot its own rules in around them and use
+// fwmark bits that do not collide with netd's.
+//
+// The priority is the value represented here added to r.ipPolicyPrefBase,
+// which is usually 5200.
+func getAndroidIPRules() []netlink.Rule {
+	rules := []netlink.Rule{
+		// Priority 12500: keep peer traffic (100.64.0.0/10) in the
+		// Tailscale table even when another VPN is active, before
+		// Android's VPN rules at 13000.
+		{
+			Priority: 7300, // 5200 + 7300 = 12500
+			Dst:      netipx.PrefixIPNet(netip.MustParsePrefix("100.64.0.0/10")),
+			Table:    tailscaleRouteTable.Num,
+		},
+		{
+			Priority: 7300, // 5200 + 7300 = 12500
+			Dst:      netipx.PrefixIPNet(netip.MustParsePrefix("fd7a:115c:a1e0::/48")),
+			Table:    tailscaleRouteTable.Num,
+		},
+
+		// Priority 13001: lookup the main table for reply traffic marked
+		// with the subnet route mark. Replies from the tailnet to hotspot
+		// clients need the downstream subnet route (e.g. 10.45.158.0/24
+		// dev wlan2) that the kernel keeps in the main table.
+		{
+			Priority: 7801, // 5200 + 7801 = 13001
+			Mark:     tsconst.LinuxSubnetRouteMarkNum,
+			Mask:     tsconst.LinuxFwmarkMaskNum,
+			Table:    mainRouteTable.Num,
+		},
+
+		// Priority 13001: packets not marked with the bypass mark go to
+		// the Tailscale table. When a VPN is up, its rules at 13000 catch
+		// traffic first; otherwise Tailscale is the fallback.
+		{
+			Priority: 7801, // 5200 + 7801 = 13001
+			Invert:   true,
+			Mark:     tsconst.LinuxBypassMarkNum,
+			Mask:     tsconst.LinuxFwmarkMaskNum,
+			Table:    tailscaleRouteTable.Num,
+		},
+	}
+
+	// Exit node / subnet router: route traffic arriving from the tailnet
+	// out through the current default network's table.
+	if table := detectAndroidDefaultTable(); table > 0 {
+		rules = append(rules, netlink.Rule{
+			Priority: 7801, // 5200 + 7801 = 13001
+			Mark:     tsconst.LinuxSubnetRouteMarkNum,
+			Mask:     tsconst.LinuxFwmarkMaskNum,
+			Table:    table,
+		})
+	}
+
+	return rules
+}
+
 // ipRules returns the appropriate list of ip rules to be used by Tailscale. See
 // comments on baseIPRules and ubntIPRules for more details.
 func ipRules() []netlink.Rule {
 	if getDistroFunc() == distro.UBNT {
 		return ubntIPRules
 	}
+	if runtime.GOOS == "android" {
+		return getAndroidIPRules()
+	}
 	return baseIPRules
 }
 
