diff --git a/util/linuxfw/android_net.go b/util/linuxfw/android_net.go
new file mode 100644
index 0000000..167fcab
--- /dev/null
+++ b/util/linuxfw/android_net.go
@@ -0,0 +1,354 @@
+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+//go:build android
+
+package linuxfw
+
+import (
+	"log"
+	"net"
+	"os/exec"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"golang.org/x/sys/unix"
+
+	"github.com/tailscale/netlink"
+	"tailscale.com/tsconst"
+)
+
+// On Android, netd keeps every network in its own routing table and selects
+// between them with policy routing rules keyed on fwmarks:
+//
+//   - a physical network's routes live in table (interface index + 1000)
+//     (RouteController.ROUTE_TABLE_OFFSET_FROM_INDEX), and netd installs
+//     per-network rules whose fwmark match value carries the network's netId
+//     in the low 16 bits;
+//   - the rule at priority 31000 (RULE_PRIORITY_DEFAULT_NETWORK) sends all
+//     packets whose netId mark bits are zero into the default network, which
+//     is a VPN app's tunnel (e.g. v2rayNG) whenever one is connected.
+//
+// A root tailscaled therefore has to mark its own sockets the way
+// VpnService.protect does: with the underlying physical network's netId plus
+// the "explicitly selected" and "protected from VPN" bits, so that the
+// per-network rules (explicit at priority 16000, or implicit at 23000) route
+// its packets straight out of the physical interface, and so that per-UID VPN
+// rules skip them.
+//
+// AndroidSocketMark detects the netId of the physical network that currently
+// holds the default route (from the policy rules, falling back to netd's
+// mangle rules) and validates candidate mark values with a real kernel route
+// lookup (a UDP connect with SO_MARK set), so that a mark that does not
+// resolve to a usable route on this device is never applied. Callers must
+// treat a 0 return value as "do not mark".
+
+const (
+	androidNetInfoCacheTTL  = 3 * time.Second
+	androidNetInfoLogPeriod = 30 * time.Second
+)
+
+var (
+	androidNetInfoMu    sync.Mutex
+	androidNetInfoCache androidNetInfo
+	androidNetInfoAt    time.Time
+	androidNetInfoSeen  time.Time // last diagnostic log time
+)
+
+type androidNetInfo struct {
+	routeTable int
+	netID      int
+	mark       int
+}
+
+// androidMarkCandidates returns the SO_MARK values to try for the given
+// netId, most preferred first. All of them carry Tailscale's bypass bit
+// (bit 28) and the protected-from-VPN bit (bit 17); they differ in whether
+// the "explicitly selected" bit (16) and the netd permission bits (18-19)
+// are set, which changes which of netd's per-network rules match:
+//
+//   - explicit + protected: matches netd's explicit per-network rules at
+//     priority 16000, exactly like VpnService.protect;
+//   - explicit + protected + permissions: also matches the explicit rules
+//     of permission-gated networks;
+//   - protected only: matches netd's implicit per-network rules at priority
+//     23000 (permission-less networks).
+func androidMarkCandidates(netID int) []int {
+	base := tsconst.LinuxBypassMarkNum | netID&tsconst.NetdNetIDMask
+	return []int{
+		base | tsconst.NetdExplicitlySelected,
+		base | tsconst.NetdExplicitlySelected | tsconst.NetdPermissionBits,
+		base,
+	}
+}
+
+// AndroidSocketMark returns the SO_MARK value that routes tailscaled's own
+// sockets straight out of the underlying physical network, or 0 when no
+// validated mark is available (detection failed or the device's policy
+// routing rejects every candidate). 0 means "do not mark".
+func AndroidSocketMark() (mark, netID int) {
+	androidNetInfoMu.Lock()
+	defer androidNetInfoMu.Unlock()
+
+	if !androidNetInfoAt.IsZero() && time.Since(androidNetInfoAt) < androidNetInfoCacheTTL {
+		return androidNetInfoCache.mark, androidNetInfoCache.netID
+	}
+
+	info := detectAndroidDefaultPhysicalNetwork()
+	androidNetInfoAt = time.Now()
+	if info.routeTable > 0 {
+		androidNetInfoCache = info
+	}
+	return androidNetInfoCache.mark, androidNetInfoCache.netID
+}
+
+// AndroidDefaultPhysicalNetwork returns the number of the routing table of
+// the physical (non-tunnel) network that currently holds the default route,
+// and its netd netId. Both are 0 when detection fails.
+func AndroidDefaultPhysicalNetwork() (routeTable, netID int) {
+	androidNetInfoMu.Lock()
+	defer androidNetInfoMu.Unlock()
+
+	if androidNetInfoAt.IsZero() || time.Since(androidNetInfoAt) >= androidNetInfoCacheTTL {
+		info := detectAndroidDefaultPhysicalNetwork()
+		androidNetInfoAt = time.Now()
+		if info.routeTable > 0 {
+			androidNetInfoCache = info
+		}
+	}
+	return androidNetInfoCache.routeTable, androidNetInfoCache.netID
+}
+
+func detectAndroidDefaultPhysicalNetwork() androidNetInfo {
+	ifaces, err := net.Interfaces()
+	if err != nil {
+		return androidNetInfo{}
+	}
+	ifName := make(map[int]string, len(ifaces))
+	for _, ifc := range ifaces {
+		ifName[ifc.Index] = ifc.Name
+	}
+
+	// Dump the routes of every routing table. RouteList only returns the
+	// main table, so ask for a table-filtered dump with the wildcard
+	// (unspecified) table to get netd's per-network tables too.
+	routes, err := netlink.RouteListFiltered(netlink.FAMILY_V4, &netlink.Route{}, netlink.RT_FILTER_TABLE)
+	if err != nil {
+		logNoValidMarkf("route dump failed: %v", err)
+		return androidNetInfo{}
+	}
+
+	type candidate struct {
+		ifname string
+		table  int
+		metric int
+	}
+	var cands []candidate
+	for _, r := range routes {
+		if r.Dst != nil || r.Table <= 0 {
+			continue // not a default route, or not a netd table
+		}
+		name := ifName[r.LinkIndex]
+		if !isAndroidPhysicalInterface(name) {
+			continue
+		}
+		cands = append(cands, candidate{ifname: name, table: r.Table, metric: r.Priority})
+	}
+	sort.SliceStable(cands, func(i, j int) bool { return cands[i].metric < cands[j].metric })
+	if len(cands) == 0 {
+		logNoValidMarkf("no default route via a physical interface")
+		return androidNetInfo{}
+	}
+
+	rules, err := netlink.RuleList(netlink.FAMILY_V4)
+	if err != nil {
+		logNoValidMarkf("rule dump failed: %v", err)
+		return androidNetInfo{}
+	}
+
+	// netd's per-network rules look up a network's own table and match on
+	// the netId bits of the fwmark, so a rule pointing at a table tells us
+	// which netId belongs to it. Requiring such a rule validates that the
+	// candidate table really is a netd-managed network.
+	netIDsFor := func(table int) []int {
+		var ids []int
+		for _, rule := range rules {
+			if rule.Table != table || rule.Mask&0xffff == 0 {
+				continue
+			}
+			if id := rule.Mark & 0xffff; id != 0 && !slicesContains(ids, id) {
+				ids = append(ids, id)
+			}
+		}
+		return ids
+	}
+
+	for _, cand := range cands {
+		var tried []int
+
+		// Source 1: the policy rules that point at this network's table.
+		for _, netID := range netIDsFor(cand.table) {
+			tried = append(tried, netID)
+			mark, err := tryMarkForNetID(netID)
+			if err == nil {
+				return androidNetInfo{routeTable: cand.table, netID: netID, mark: mark}
+			}
+			if err != errNoValidMark {
+				logNoValidMarkf("netId %#x: %v", netID, err)
+			}
+		}
+
+		// Source 2: netd's incoming-packet marks in the mangle table carry
+		// the netId of the network behind each physical interface and are
+		// independent of the policy rule layout.
+		for _, netID := range netIDsFromMangle(cand.ifname) {
+			if slicesContains(tried, netID) {
+				continue
+			}
+			tried = append(tried, netID)
+			mark, err := tryMarkForNetID(netID)
+			if err == nil {
+				return androidNetInfo{routeTable: cand.table, netID: netID, mark: mark}
+			}
+			if err != errNoValidMark {
+				logNoValidMarkf("netId %#x (mangle): %v", netID, err)
+			}
+		}
+
+		if len(tried) > 0 {
+			logNoValidMarkf("table %d (%s): no validated netId among %v", cand.table, cand.ifname, tried)
+		} else {
+			logNoValidMarkf("table %d (%s): no netId found in policy rules or mangle marks", cand.table, cand.ifname)
+		}
+	}
+	return androidNetInfo{}
+}
+
+// errNoValidMark is returned by tryMarkForNetID when every candidate mark for
+// a netId was rejected by the kernel's route lookup.
+var errNoValidMark = errStr("no validated mark")
+
+type errStr string
+
+func (e errStr) Error() string { return string(e) }
+
+// tryMarkForNetID returns the first candidate mark for netID that a real
+// kernel route lookup accepts. The returned error is errNoValidMark when the
+// lookup failed for all candidates, or the underlying error when the mark
+// could not be applied at all (e.g. a setsockopt failure).
+func tryMarkForNetID(netID int) (int, error) {
+	lastErr := error(errNoValidMark)
+	for _, mark := range androidMarkCandidates(netID) {
+		ok, err := markRoutesV4(mark)
+		if ok {
+			return mark, nil
+		}
+		if err != nil {
+			lastErr = err
+		}
+	}
+	return 0, lastErr
+}
+
+// markRoutesV4 reports whether a route lookup for a public IPv4 address
+// succeeds with the given SO_MARK applied. It uses a datagram socket
+// connect(), which performs exactly the same policy routing walk as a real
+// dial but sends no packet. ok=false with a nil error means the kernel's
+// policy routing found no route for the marked socket.
+func markRoutesV4(mark int) (ok bool, err error) {
+	fd, err := unix.Socket(unix.AF_INET, unix.SOCK_DGRAM|unix.SOCK_CLOEXEC, 0)
+	if err != nil {
+		return false, err
+	}
+	defer unix.Close(fd)
+
+	if err := unix.SetsockoptInt(fd, unix.SOL_SOCKET, unix.SO_MARK, mark); err != nil {
+		return false, err
+	}
+	if err := unix.Connect(fd, &unix.SockaddrInet4{Port: 53, Addr: [4]byte{8, 8, 8, 8}}); err != nil {
+		return false, nil
+	}
+	return true, nil
+}
+
+// netIDsFromMangle parses netd's incoming-packet mark rules
+// (RouteController::modifyIncomingPacketMark, installed in the mangle table
+// for every physical network) and returns the netIds they set for the given
+// interface. The rules look like:
+//
+//	-A routectrl_mangle_INPUT -i wlan0 -j MARK --set-xmark 0x10066/0xfeffffff
+func netIDsFromMangle(ifname string) []int {
+	if ifname == "" {
+		return nil
+	}
+	out, err := exec.Command("iptables", "-t", "mangle", "-S").Output()
+	if err != nil {
+		return nil
+	}
+	var ids []int
+	for _, line := range strings.Split(string(out), "\n") {
+		if !strings.Contains(line, "-i "+ifname+" ") {
+			continue
+		}
+		marker := "--set-xmark "
+		m := strings.Index(line, marker)
+		if m == -1 {
+			marker = "--set-mark "
+			m = strings.Index(line, marker)
+		}
+		if m == -1 {
+			continue
+		}
+		value := line[m+len(marker):]
+		if slash := strings.IndexByte(value, '/'); slash != -1 {
+			value = value[:slash]
+		}
+		v, err := strconv.ParseUint(strings.TrimSpace(value), 0, 32)
+		if err != nil {
+			continue
+		}
+		if id := int(v) & tsconst.NetdNetIDMask; id != 0 && !slicesContains(ids, id) {
+			ids = append(ids, id)
+		}
+	}
+	return ids
+}
+
+func slicesContains(s []int, v int) bool {
+	for _, e := range s {
+		if e == v {
+			return true
+		}
+	}
+	return false
+}
+
+// logNoValidMarkf logs a detection diagnostic at most once per
+// androidNetInfoLogPeriod so failures stay visible without spamming.
+func logNoValidMarkf(format string, args ...any) {
+	now := time.Now()
+	if !androidNetInfoSeen.IsZero() && now.Sub(androidNetInfoSeen) < androidNetInfoLogPeriod {
+		return
+	}
+	androidNetInfoSeen = now
+	log.Printf("linuxfw/android: "+format, args...)
+}
+
+// isAndroidPhysicalInterface reports whether name looks like a physical
+// uplink interface instead of a tunnel or virtual interface created by a
+// VPN app or by Tailscale itself.
+func isAndroidPhysicalInterface(name string) bool {
+	switch name {
+	case "", "lo", "sit0", "ip6tnl0":
+		return false
+	}
+	for _, prefix := range []string{"tun", "tailscale", "wg", "dummy", "v4-"} {
+		if strings.HasPrefix(name, prefix) {
+			return false
+		}
+	}
+	return true
+}
