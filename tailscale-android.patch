diff --git a/util/osuser/user_android.go b/util/osuser/user_android.go
new file mode 100644
index 0000000..62edbe8
--- /dev/null
+++ b/util/osuser/user_android.go
@@ -0,0 +1,84 @@
+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+//go:build android
+
+package osuser
+
+import (
+	"context"
+	"os"
+	"os/exec"
+	"os/user"
+	"strings"
+	"time"
+)
+
+func init() {
+	overrideLookupFunc = androidLookup
+}
+
+// androidLookup implements user lookup for Android, which has no getent and
+// no /etc/passwd entry for app users, so everything is derived from `id`.
+func androidLookup(usernameOrUID string, wantShell bool) (*user.User, string, error) {
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+
+	var shell string
+	if wantShell {
+		if out, err := exec.LookPath("bash"); err == nil {
+			shell = out
+		} else if out, err := exec.LookPath("sh"); err == nil {
+			shell = out
+		} else {
+			shell = "/system/bin/sh"
+		}
+	}
+
+	uid := getAndroidCommandOutput(ctx, "id", "-u", usernameOrUID, "")
+	if uid == "" {
+		// Unknown user, fall back to root.
+		usernameOrUID = "root"
+		uid = getAndroidCommandOutput(ctx, "id", "-u", "0", "")
+	}
+
+	gid := getAndroidCommandOutput(ctx, "id", "-g", usernameOrUID, "0")
+	username := getAndroidCommandOutput(ctx, "id", "-un", usernameOrUID, usernameOrUID)
+	homeDir := getAndroidHomeDir("/")
+
+	return &user.User{
+		Uid:      uid,
+		Gid:      gid,
+		Username: username,
+		Name:     "Android",
+		HomeDir:  homeDir,
+	}, shell, nil
+}
+
+// getAndroidCommandOutput runs cmd and returns its trimmed output, or the last
+// element of args (the default) if the command fails.
+func getAndroidCommandOutput(ctx context.Context, cmd string, args ...string) string {
+	if len(args) == 0 {
+		return ""
+	}
+
+	defaultValue := args[len(args)-1]
+	cmdArgs := args[:len(args)-1]
+
+	out, err := exec.CommandContext(ctx, cmd, cmdArgs...).Output()
+	if err != nil {
+		return defaultValue
+	}
+
+	return strings.TrimSpace(string(out))
+}
+
+// getAndroidHomeDir returns the home directory, falling back to defaultDir.
+func getAndroidHomeDir(defaultDir string) string {
+	if home, err := os.UserHomeDir(); err == nil {
+		if home = strings.TrimSpace(home); home != "" {
+			return home
+		}
+	}
+	return defaultDir
+}
