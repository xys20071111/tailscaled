+// createTailscaleSymlink creates a "tailscale" symlink next to the current
+// "tailscaled" binary on Android, so that the combined tailscale/tailscaled
+// binary can be invoked under either name.
+func createTailscaleSymlink() {
+	execPath, err := os.Executable()
+	if err != nil {
+		return // Not critical.
+	}
+
+	realPath, err := filepath.EvalSymlinks(execPath)
+	if err != nil {
+		realPath = execPath
+	}
+
+	binName := filepath.Base(realPath)
+	symlinkPath := filepath.Join(filepath.Dir(realPath), "tailscale")
+
+	if _, err := os.Lstat(symlinkPath); err == nil {
+		// Already a symlink pointing at us? Then there is nothing to do.
+		if target, err := os.Readlink(symlinkPath); err == nil && target == binName {
+			return
+		}
+		os.Remove(symlinkPath)
+	}
+
+	_ = os.Symlink(binName, symlinkPath)
+}
