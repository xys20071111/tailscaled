new file mode 100644
index 0000000..93cfcd7
--- /dev/null
+++ b/hostinfo/hostinfo_android.go
@@ -0,0 +1,80 @@
+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+//go:build android
+
+package hostinfo
+
+import (
+	"os/exec"
+	"strings"
+
+	"tailscale.com/tailcfg"
+)
+
+// On Android the kernel hostname is either unset or "localhost", so the node
+// would otherwise show up as "localhost" in the admin console. Fill in the
+// manufacturer/model and the OS version from getprop instead.
+func init() {
+	RegisterHostinfoNewHook(func(hi *tailcfg.Hostinfo) {
+		if hi.Hostname == "" || hi.Hostname == "node" || hi.Hostname == "localhost" {
+			hi.Hostname = sanitizeHostname(
+				getSystemProperty("ro.product.manufacturer") + "-" +
+					getSystemProperty("ro.product.model"),
+			)
+			if hi.Hostname == "" {
+				hi.Hostname = "android"
+			}
+		}
+
+		if hi.OSVersion == "" {
+			hi.OSVersion = getSystemProperty("ro.build.version.release")
+		}
+
+		if hi.DeviceModel == "" {
+			hi.DeviceModel = getSystemProperty("ro.product.model")
+		}
+	})
+}
+
+// getSystemProperty reads an Android system property via getprop.
+func getSystemProperty(prop string) string {
+	out, err := exec.Command("getprop", prop).Output()
+	if err != nil {
+		return ""
+	}
+	return strings.TrimSpace(string(out))
+}
+
+// sanitizeHostname removes characters that are not valid in a hostname.
+// Valid hostnames contain only alphanumerics and hyphens.
+func sanitizeHostname(s string) string {
+	s = strings.ToLower(s)
+	var result strings.Builder
+
+	for _, ch := range s {
+		switch {
+		case (ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9'):
+			result.WriteRune(ch)
+		case ch == '-' || ch == '_' || ch == ' ':
+			// Convert spaces and underscores to hyphens, without
+			// producing runs of them.
+			if b := result.String(); b != "" && b[len(b)-1] != '-' {
+				result.WriteRune('-')
+			}
+		}
+	}
+
+	hostname := result.String()
+	hostname = strings.Trim(hostname, "-")
+	for strings.Contains(hostname, "--") {
+		hostname = strings.ReplaceAll(hostname, "--", "-")
+	}
+
+	// Limit to 63 characters (max label length in a hostname).
+	if len(hostname) > 63 {
+		hostname = strings.TrimRight(hostname[:63], "-")
+	}
+
+	return hostname
+}
