+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+//go:build android
+
+package tsconst
+
+// Linux firewall constants used by Tailscale on Android.
+
+// The following bits are added to packet marks for Tailscale use.
+//
+// On Android, netd owns the fwmark layout. Bits 0-20 are allocated by AOSP,
+// so Tailscale cannot use the Linux default bits 16:23 and claims bits
+// 25:28 instead.
+//
+// Bits 0-20 of the mark still have to follow netd's conventions so that
+// tailscaled's own sockets are routed like sockets protected with
+// VpnService.protect: with the underlying physical network's netId in bits
+// 0-15 and the "explicitly selected" and "protected from VPN" bits set.
+// Without them, a foreign VPN app that is the default network captures all
+// of tailscaled's traffic (WireGuard UDP, DERP, control plane) through its
+// tunnel. See util/linuxfw/android_net.go for how the netId is detected.
+//
+// Ref: https://android.googlesource.com/platform/system/netd/+/master/include/Fwmark.h
+// Ref: https://android.googlesource.com/platform/system/netd/+/master/server/RouteController.h
+// Ref: https://www.kxxt.dev/blog/full-tailscale-on-android-and-remote-unlocking/
+//
+// The constants are in the iptables/iproute2 string format for
+// matching and setting the bits, so they can be directly embedded in
+// commands.
+const (
+	// The mask for reading/writing the 'firewall mask' bits on a packet.
+	// We claim bits 25:28 entirely.
+	LinuxFwmarkMask    = "0x1e000000"
+	LinuxFwmarkMaskNum = 0x1e000000
+
+	// Packet is from Tailscale and to a subnet route destination, so
+	// is allowed to be routed through this machine.
+	LinuxSubnetRouteMark    = "0x8000000"
+	LinuxSubnetRouteMarkNum = 0x8000000
+
+	// Packet was originated by tailscaled itself, and must not be
+	// routed over the Tailscale network.
+	//
+	// Includes bit 17 (0x20000), Android's ProtectedFromVPN mark.
+	LinuxBypassMark    = "0x10020000"
+	LinuxBypassMarkNum = 0x10020000
+)
+
+// Android netd fwmark bits (AOSP system/netd include/Fwmark.h). Bits 0-15
+// hold the netId of the network a packet belongs to.
+const (
+	// NetdExplicitlySelected is bit 16: the socket (or packet mark) has
+	// explicitly selected the network in the netId bits.
+	NetdExplicitlySelected = 0x10000
+
+	// NetdProtectedFromVPN is bit 17: the packet must not be routed
+	// through a VPN app's tunnel. Already part of LinuxBypassMarkNum.
+	NetdProtectedFromVPN = 0x20000
+
+	// NetdPermissionBits covers both netd permission bits (18-19,
+	// PERMISSION_NETWORK and PERMISSION_SYSTEM), so that a root daemon's
+	// sockets match netd's per-network explicit rules of any network.
+	NetdPermissionBits = 0xc0000
+
+	// NetdNetIDMask masks the netId bits (0-15).
+	NetdNetIDMask = 0xffff
+)
